# back/.env.prod.example — Template de variables d'environnement pour la PRODUCTION
#
# Ce fichier est commité (valeurs vides / placeholders uniquement).
# En production : copier ce fichier en back/.env.local (gitignored)
# et renseigner chaque variable avec une vraie valeur.
#
# NE JAMAIS commiter back/.env.local ni aucun fichier contenant de vrais secrets.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0

# Générer avec : openssl rand -hex 32
APP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format : mysql://USER:PASSWORD@HOST:PORT/DBNAME?serverVersion=8.0&charset=utf8mb4
DATABASE_URL="mysql://sportlink:CHANGE_ME_db_password@db:3306/sportlink?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# Générer avec : openssl rand -hex 32
# Régénérer la paire de clés JWT après avoir défini cette passphrase :
#   php bin/console lexik:jwt:generate-keypair --overwrite
JWT_PASSPHRASE=CHANGE_ME_generate_with_openssl_rand_hex_32
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Remplacer par le domaine réel du frontend (sans trailing slash)
# Exemple : CORS_ALLOW_ORIGIN='^https://sportlink\.example\.com$'
CORS_ALLOW_ORIGIN='^https://CHANGE_ME_your_frontend_domain$'
###< nelmio/cors-bundle ###
